{
  "name": "maintenance-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Maintenance Hub (nom de travail) — place de marché B2B de maintenance frigorifique commerciale",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch --tsconfig tsconfig.worker.json src/worker/index.ts",
    "worker:start": "tsx --tsconfig tsconfig.worker.json src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.worker.json scripts/seed.ts",
    "db:reset-dev": "tsx scripts/db-reset-dev.ts",
    "admin:create": "tsx --tsconfig tsconfig.worker.json scripts/create-admin.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:diff": "tsx scripts/db-diff.ts",
    "db:reference": "tsx --tsconfig tsconfig.worker.json scripts/ensure-reference.ts",
    "user:anonymize": "tsx --tsconfig tsconfig.worker.json scripts/anonymize-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "file-type": "22.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "nodemailer": "10.0.11",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@prisma/schema-engine-wasm": "7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
