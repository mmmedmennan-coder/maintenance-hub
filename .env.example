# Maintenance Hub — example configuration. Copy to `.env` (and `.env.test` for tests)
# and replace every placeholder. Never commit real credentials.

NODE_ENV=development
APP_NAME="Maintenance Hub"
# Public base URL of the web application (used in e-mails and auth callbacks).
APP_URL=http://localhost:3000

# --- Better Auth -------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- PostgreSQL ----------------------------------------------------------------
# Role names are fixed (migrations reference them). Passwords: 12+ characters.
# Superuser URL: used only by `npm run db:bootstrap` on local/staging machines.
POSTGRES_SUPERUSER_URL=postgresql://postgres:change-me-superuser@localhost:5432/postgres
# Password of the docker compose PostgreSQL container (must match the URL above).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Owner role: migrations only.
MIGRATION_DATABASE_URL=postgresql://mh_owner:change-me-owner-password@localhost:5432/maintenance_hub
# Web runtime role (row-level security enforced).
DATABASE_URL=postgresql://mh_app:change-me-app-password@localhost:5432/maintenance_hub
# Better Auth runtime role (identity tables only).
AUTH_DATABASE_URL=postgresql://mh_auth:change-me-auth-password@localhost:5432/maintenance_hub
# Background worker role.
WORKER_DATABASE_URL=postgresql://mh_worker:change-me-worker-password@localhost:5432/maintenance_hub

# --- Private files -------------------------------------------------------------
# local: files under STORAGE_LOCAL_DIR (outside /public). s3: S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
# HMAC secret for short-lived download links (32+ random characters).
FILE_SIGNING_SECRET=replace-with-another-long-random-secret-32-chars
# Required when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- E-mail --------------------------------------------------------------------
# Development: Mailpit (docker compose) captures everything on port 1025, UI on 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Maintenance Hub <no-reply@maintenance-hub.test>"

# --- Business settings ---------------------------------------------------------
# Hours a provider has to confirm a selected offer before the booking expires.
BOOKING_CONFIRMATION_HOURS=24
# Allows `npm run db:seed` (demonstration data). Must be false/absent in production.
ALLOW_DEMO_SEED=true
# Optional: shared password of the demo accounts created by the seed (default documented in README).
# DEMO_PASSWORD=
# Sign-in attempts per minute and IP (Better Auth limiter). Keep low outside automated tests.
AUTH_SIGNIN_RATE_LIMIT_PER_MINUTE=5

# --- Worker ----------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
